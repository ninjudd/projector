+    def test_each_condition_reaches_the_store_and_a_failed_one_raises_its_own_error(self) -> None:
+        self.env_keys()
+        client = self.client()
+
+        first = client.put_object("relay/k/agents/a", b"{}", if_none_match=True)
+        with self.assertRaises(s3.PreconditionFailed):
