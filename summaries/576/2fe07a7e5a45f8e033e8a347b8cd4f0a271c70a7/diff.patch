 gate = 'claude plugin validate . && claude plugin validate skills && claude plugin test . && hooks/typecheck.sh && git diff --check "$2" HEAD'
+# Each pull request whose head is in this repository is reviewed in GitHub Actions by
+# .github/workflows/projector-review.yml, which posts as github-actions[bot].
+ci = true
+ci_agents = "claude"
+reviewers = "github-actions[bot]"
