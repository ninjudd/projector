index 00000000..308b59c1
--- /dev/null
+++ b/.github/workflows/projector-review.yml
@@ -0,0 +1,89 @@
+# Written by `project init --ci-review`, which replaces this file while nobody has edited it.
+# projector-workflow sha256=83ae431387c1ecc9bcdac5c46931270c37d76040bb533fa1143d3612c47d51cc
+name: Projector review
+
+# Reviews each ready pull request whose head is in this repository with
+# `project review run`, one job for each agent, and publishes each review's
+# summary from a second job that runs no agent. `project review run` refuses a
+# fork's pull request and a draft however the workflow starts, so a manual run
+# cannot review either. Each agent's job reads the one credential secret that
+# is set for it: a subscription's or an API key. Secrets that are not set read
+# as empty.
+on:
+  pull_request:
+    types: [opened, reopened, synchronize, ready_for_review]
+  workflow_dispatch:
+    inputs:
+      pr:
+        description: The pull request to review
+        required: true
+      rereview:
+        description: Review a head this model already reviewed
+        type: boolean
+        default: false
+
+permissions: {}
+
+jobs:
+  review:
+    if: >-
+      github.event_name == 'workflow_dispatch' ||
+      (!github.event.pull_request.draft &&
+       github.event.pull_request.head.repo.full_name == github.repository)
+    permissions:
+      contents: read
+      pull-requests: write
+      issues: write
+      statuses: write
+      checks: read
+      actions: read
+      pages: read
+    strategy:
+      fail-fast: false
+      # An agent with no model runs the action's default for it.
+      matrix:
+        include:
+          - agent: claude
+    concurrency:
+      group: projector-review-${{ github.event.pull_request.number || inputs.pr }}-${{ matrix.agent }}
+      cancel-in-progress: true
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      # Projector runs the action from the pull request's own checkout, so a pull request that changes the
+      # action is reviewed by the action it carries. Only a same-repository head gets here, and `project review
+      # run` refuses any other, so the action that runs is one a writer of this repository pushed.
+      - uses: actions/checkout@v4
+      - uses: ./actions/review
+        with:
+          agent: ${{ matrix.agent }}
+          model: ${{ matrix.model }}
+          pr: ${{ github.event.pull_request.number || inputs.pr }}
+          rereview: ${{ inputs.rereview || false }}
+          # The gate's hooks/typecheck.sh compiles against declarations only an interactive Claude Code session
+          # writes, so a review on a runner runs the rest of the gate without it.
+          config: |
+            [override.50.review]
+            gate = 'claude plugin validate . && claude plugin validate skills && claude plugin test . && git diff --check "$2" HEAD'
+        env:
+          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
+          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
+
+  summary:
+    needs: review
+    if: ${{ !cancelled() && needs.review.result != 'skipped' }}
+    permissions:
+      contents: write
+      pull-requests: write
+      issues: write
+      pages: read
+    concurrency:
+      group: projector-summary-${{ github.event.pull_request.number || inputs.pr }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: ./actions/review
+        with:
+          step: summary
+          pr: ${{ github.event.pull_request.number || inputs.pr }}
