@@ -0,0 +1,149 @@
+import { describe, expect, test } from 'claude-code/testing'
+
+import { buildQuery, parseResponse } from './github'
+import { expandPath, findWatchers, parseTracked } from './parse'
+
+const VARIABLES: Record<string, string> = { HOME: '/home/ada' }
+const env = (name: string) => VARIABLES[name]
+
+describe('findWatchers', () => {
+  test('reads the tracked path of a review watcher', () => {
+    expect(
+      findWatchers('scripts/watch-prs.sh --tracked /loops/tracked --state /loops/state --once', env),
+    ).toEqual([{ kind: 'reviewing', tracked: '/loops/tracked', written: '/loops/tracked' }])
+  })
+
+  test('reads a fix watcher behind cd, quotes and a variable script path', () => {
+    const command =
+      'cd /repo && "$ROOT/skills/start-fix-loop/scripts/watch-threads.sh" --tracked "$HOME/fix loop/tracked" --state s'
+    expect(findWatchers(command, env)).toEqual([
+      { kind: 'watching', tracked: '/home/ada/fix loop/tracked', written: '$HOME/fix loop/tracked' },
+    ])
+  })
+
+  test('expands ~ and leaves single-quoted text alone', () => {
+    expect(findWatchers('watch-prs.sh --tracked ~/t', env)[0]?.tracked).toBe('/home/ada/t')
+    expect(findWatchers("watch-prs.sh --tracked '$HOME/t'", env)[0]?.tracked).toBe('$HOME/t')
+    expect(findWatchers('watch-prs.sh --tracked=${HOME}/t', env)[0]?.tracked).toBe('/home/ada/t')
+  })
+
+  test('leaves a path it cannot expand undefined', () => {
+    expect(findWatchers('watch-prs.sh --tracked "$LOOP/tracked"', env)).toEqual([
+      { kind: 'reviewing', tracked: undefined, written: '$LOOP/tracked' },
+    ])
+    expect(findWatchers('watch-prs.sh --tracked "$(pwd)/tracked"', env)[0]?.tracked).toBeUndefined()
+  })
+
+  test('expands a variable the command assigns before the watcher', () => {
+    const command =
+      'D=~/.local/state/projector; ID=projector-review-loop; bash /p/watch-prs.sh --tracked $D/$ID.tracked --state s'
+    expect(findWatchers(command, env)[0]?.tracked).toBe('/home/ada/.local/state/projector/projector-review-loop.tracked')
+    expect(findWatchers('export T="$HOME/t" && watch-threads.sh --tracked "$T"', env)[0]?.tracked).toBe('/home/ada/t')
+    expect(findWatchers('watch-prs.sh --tracked $D/t; D=/late', env)[0]?.tracked).toBeUndefined()
+    expect(findWatchers('D=$(pwd); watch-prs.sh --tracked $D/t', env)[0]?.tracked).toBeUndefined()
+  })
+
+  test('stops at the end of the watcher command', () => {
+    expect(findWatchers('watch-prs.sh --once; echo --tracked /x', env)).toEqual([])
+    expect(findWatchers('watch-prs.sh --once && other --tracked /x', env)).toEqual([])
+  })
+
+  test('ignores a command that only mentions a watcher', () => {
+    expect(findWatchers("echo 'watch-prs.sh --tracked /x'", env)).toEqual([])
+    expect(findWatchers('cat skills/start-review-loop/scripts/watch-prs.sh', env)).toEqual([])
+    expect(findWatchers('my-watch-prs.sh --tracked /x', env)).toEqual([])
+  })
+})
+
+describe('expandPath', () => {
+  test('expands one word and refuses more', () => {
+    expect(expandPath('~/loops/tracked', env)).toBe('/home/ada/loops/tracked')
+    expect(expandPath('"/a b/tracked"', env)).toBe('/a b/tracked')
+    expect(expandPath('/a /b', env)).toBeUndefined()
+  })
+})
+
+describe('parseTracked', () => {
+  test('keeps entries in order, once each, less the excluded ones', () => {
+    const text = 'o/r#1\no/r#2\n!o/r#2\n\nnot an entry\no/r#1\n  other/re.po#30  \no/r#0\n'
+    expect(parseTracked(text)).toEqual([
+      { repo: 'o/r', number: 1 },
+      { repo: 'other/re.po', number: 30 },
+    ])
+  })
+
+  test('matches entries and exclusions without regard to case', () => {
+    expect(parseTracked('Owner/Repo#5\nowner/repo#5\nowner/repo#6\n!OWNER/REPO#6\n')).toEqual([
+      { repo: 'Owner/Repo', number: 5 },
+    ])
+  })
+})
+
+describe('GitHub', () => {
+  const query = buildQuery([
+    { repo: 'o/r', number: 1 },
+    { repo: 'o/r', number: 2 },
+    { repo: 'x/y', number: 3 },
+  ])
+
+  test('asks for every pull request in one query, grouped by repository', () => {
+    expect(query.text).toContain('r0: repository(owner: "o", name: "r") { p1: pullRequest(number: 1)')
+    expect(query.text).toContain('p2: pullRequest(number: 2)')
+    expect(query.text).toContain('r1: repository(owner: "x", name: "y") { p3: pullRequest(number: 3)')
+  })
+
+  test('reads what came back even when one pull request is missing', () => {
+    const body = {
+      data: {
+        r0: {
+          p1: {
+            number: 1,
+            title: 'First',
+            url: 'https://github.com/o/r/pull/1',
+            state: 'OPEN',
+            isDraft: true,
+            reviewDecision: 'CHANGES_REQUESTED',
+            mergeable: 'CONFLICTING',
+            reviewThreads: { nodes: [{ isResolved: false }, { isResolved: true }, { isResolved: false }] },
+          },
+          p2: null,
+        },
+        r1: { p3: { number: 3, title: 'Third', state: 'MERGED', isDraft: false, mergeable: 'UNKNOWN' } },
+      },
+      errors: [{ message: 'Could not resolve to a PullRequest with the number of 2.' }],
+    }
+    const fetched = parseResponse(query, { exitCode: 1, stdout: JSON.stringify(body), stderr: '' })
+
+    expect(fetched.error).toBeNull()
+    expect([...fetched.prs.keys()]).toEqual(['o/r#1', 'x/y#3'])
+    expect(fetched.prs.get('o/r#1')).toEqual({
+      repo: 'o/r',
+      number: 1,
+      title: 'First',
+      url: 'https://github.com/o/r/pull/1',
+      state: 'OPEN',
+      isDraft: true,
+      reviewDecision: 'CHANGES_REQUESTED',
+      isConflicting: true,
+      openThreads: 2,
+    })
+    expect(fetched.prs.get('x/y#3')?.state).toBe('MERGED')
+    expect(fetched.prs.get('x/y#3')?.url).toBe('https://github.com/x/y/pull/3')
+  })
+
+  test('reports why gh failed', () => {
+    const offline = parseResponse(query, {
+      exitCode: 1,
+      stdout: '',
+      stderr: 'error connecting to api.github.com\ncheck your internet connection\n',
+    })
+    expect(offline).toEqual({ prs: new Map(), error: 'error connecting to api.github.com' })
+
+    const refused = parseResponse(query, {
+      exitCode: 1,
+      stdout: JSON.stringify({ errors: [{ message: 'Bad credentials' }] }),
+      stderr: '',
+    })
+    expect(refused.error).toBe('Bad credentials')
+  })
+})
diff --git a/hooks/parse.ts b/hooks/parse.ts
new file mode 100644
index 0000000..7f7000b
--- /dev/null
+++ b/hooks/parse.ts
@@ -0,0 +1,231 @@
+import type { LoopKind } from './types'
+
+/** Looks up an environment variable; undefined when it is unset or unknown. */
+export type Env = (name: string) => string | undefined
+
+/** A watcher found in a command line, and the tracked path it was given. */
+export type Watcher = {
+  kind: LoopKind
+  /** The path, expanded; undefined when it could not be expanded. */
+  tracked: string | undefined
+  /** The `--tracked` argument as written, for messages. */
+  written: string
+}
+
+/** One `owner/repo#number` entry of a tracked file. */
+export type TrackedPr = { repo: string; number: number }
+
+const SCRIPTS: Record<string, LoopKind> = {
+  'watch-prs.sh': 'reviewing',
+  'watch-threads.sh': 'watching',
+}
+
+const OPERATORS = ['&&', '||', ';', '&', '|', '(', ')', '\n']
+
+type Part = { text: string; isLiteral: boolean }
+type Token = { parts: Part[] } | { operator: string }
+
+/**
+ * Splits a shell command into words and operators, keeping which parts of a
+ * word were quoted so that expansion leaves single-quoted text alone.
+ */
+export function tokenize(command: string): Token[] {
+  const tokens: Token[] = []
+  let parts: Part[] = []
+  let isInWord = false
+
+  const add = (text: string, isLiteral: boolean) => {
+    isInWord = true
+    const last = parts[parts.length - 1]
+    if (last !== undefined && last.isLiteral === isLiteral) {
+      last.text += text
+    } else {
+      parts.push({ text, isLiteral })
+    }
+  }
+  const end = () => {
+    if (isInWord) tokens.push({ parts })
+    parts = []
+    isInWord = false
+  }
+
+  let i = 0
+  while (i < command.length) {
+    const char = command[i] as string
+    const operator = OPERATORS.find(op => command.startsWith(op, i))
+    if (char === ' ' || char === '\t') {
+      end()
+      i += 1
+    } else if (operator !== undefined) {
+      end()
+      tokens.push({ operator })
+      i += operator.length
+    } else if (char === '#' && !isInWord) {
+      while (i < command.length && command[i] !== '\n') i += 1
+    } else if (char === "'") {
+      const close = command.indexOf("'", i + 1)
+      const stop = close === -1 ? command.length : close
+      add(command.slice(i + 1, stop), true)
+      i = stop + 1
+    } else if (char === '"') {
+      i += 1
+      while (i < command.length && command[i] !== '"') {
+        const inner = command[i] as string
+        const next = command[i + 1]
+        if (inner === '\\' && next !== undefined && '"\\$`'.includes(next)) {
+          add(next, true)
+          i += 2
+        } else {
+          add(inner, false)
+          i += 1
+        }
+      }
+      if (!isInWord) add('', true)
+      i += 1
+    } else if (char === '\\') {
+      const next = command[i + 1]
+      if (next !== undefined && next !== '\n') add(next, true)
+      i += 2
+    } else {
+      add(char, false)
+      i += 1
+    }
+  }
+  end()
+
+  return tokens
+}
+
+const VARIABLE = /\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)/g
+
+/**
+ * Expands a word the way the shell would for a path: a leading `~` and
+ * `$NAME` or `${NAME}` outside single quotes. Undefined when the word holds
+ * something only the running shell knows, such as an unset variable or a
+ * command substitution.
+ */
+export function expand(parts: readonly Part[], env: Env): string | undefined {
+  let out = ''
+  for (const [index, part] of parts.entries()) {
+    if (part.isLiteral) {
+      out += part.text
+      continue
+    }
+    let text = part.text
+    if (text.includes('$(') || text.includes('`')) return undefined
+    if (index === 0 && (text === '~' || text.startsWith('~/'))) {
+      const home = env('HOME')
+      if (home === undefined) return undefined
+      text = home + text.slice(1)
+    }
+    let isKnown = true
+    text = text.replace(VARIABLE, (_, braced: string | undefined, bare: string | undefined) => {
+      const value = env(braced ?? bare ?? '')
+      if (value === undefined) isKnown = false
+      return value ?? ''
+    })
+    if (!isKnown || text.includes('$')) return undefined
+    out += text
+  }
+  return out
+}
+
+/** Expands a path typed as one shell word, such as `/loop-prs ~/loop/tracked`. */
+export function expandPath(text: string, env: Env): string | undefined {
+  const tokens = tokenize(text.trim())
+  const [word] = tokens
+  if (tokens.length !== 1 || word === undefined || !('parts' in word)) return undefined
+  return expand(word.parts, env)
+}
+
+const raw = (parts: readonly Part[]) => parts.map(part => part.text).join('')
+
+const ASSIGNMENT = /^([A-Za-z_][A-Za-z0-9_]*)=/
+
+/**
+ * Finds each `watch-prs.sh` or `watch-threads.sh` invocation in a command
+ * line and the `--tracked` path given to it. A variable the command assigns
+ * before the watcher, as in `D=~/loops; watch-prs.sh --tracked $D/tracked`,
+ * expands ahead of the environment.
+ */
+export function findWatchers(command: string, env: Env): Watcher[] {
+  const tokens = tokenize(command)
+  const found: Watcher[] = []
+  const assigned = new Map<string, string | undefined>()
+  const lookup: Env = name => (assigned.has(name) ? assigned.get(name) : env(name))
+  let isCommandStart = true
+
+  for (const [index, token] of tokens.entries()) {
+    if (!('parts' in token)) {
+      isCommandStart = true
+      continue
+    }
+    const [first, ...rest] = token.parts
+    const assignment =
+      isCommandStart && first !== undefined && !first.isLiteral ? ASSIGNMENT.exec(first.text) : null
+    if (assignment !== null && first !== undefined) {
+      const [written, name] = assignment as unknown as [string, string]
+      assigned.set(name, expand([{ ...first, text: first.text.slice(written.length) }, ...rest], lookup))
+      continue
+    }
+    if (isCommandStart && raw(token.parts) === 'export') continue
+    isCommandStart = false
+
+    const name = raw(token.parts).split('/').pop() ?? ''
+    const kind = SCRIPTS[name]
+    if (kind === undefined) continue
+
+    for (let at = index + 1; at < tokens.length; at += 1) {
+      const arg = tokens[at] as Token
+      if (!('parts' in arg)) break
+      const text = raw(arg.parts)
+      if (text === '--tracked') {
+        const value = tokens[at + 1]
+        if (value === undefined || !('parts' in value)) break
+        found.push({ kind, tracked: expand(value.parts, lookup), written: raw(value.parts) })
+        break
+      }
+      if (text.startsWith('--tracked=')) {
+        const [first, ...rest] = arg.parts
+        if (first === undefined) break
+        const value = [{ ...first, text: first.text.slice('--tracked='.length) }, ...rest]
+        found.push({ kind, tracked: expand(value, lookup), written: raw(value) })
+        break
+      }
+    }
+  }
+
+  return found
+}
+
+const ENTRY = /^(!?)([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)#([1-9][0-9]*)$/
+
+/** Names a pull request without regard to case, as GitHub and the watchers do. */
+export const keyOf = (pr: TrackedPr) => `${pr.repo}#${pr.number}`.toLowerCase()
+
+/**
+ * Reads a tracked file: one `owner/repo#number` per line, where a line
+ * `!owner/repo#number` keeps that pull request out. Lines of any other
+ * shape are skipped; the watcher reports them itself.
+ */
+export function parseTracked(text: string): TrackedPr[] {
+  const kept = new Map<string, TrackedPr>()
+  const excluded = new Set<string>()
+
+  for (const line of text.split('\n')) {
+    const match = ENTRY.exec(line.trim())
+    if (match === null) continue
+    const [, bang, repo, number] = match as unknown as [string, string, string, string]
+    const pr = { repo, number: Number(number) }
+    const key = keyOf(pr)
+    if (bang === '!') {
+      excluded.add(key)
+    } else if (!kept.has(key)) {
+      kept.set(key, pr)
+    }
+  }
+
+  return [...kept.entries()]
+    .filter(([key]) => !excluded.has(key))
+    .map(([, pr]) => pr)
+}
diff --git a/hooks/register.tsx b/hooks/register.tsx
new file mode 100644
index 0000000..f2dcac2
--- /dev/null
+++ b/hooks/register.tsx
@@ -0,0 +1,367 @@
+import { atom, read, update } from 'claude-code'
+import type { EngineInterface, Register } from 'claude-code'
+
+import type { LoopKind, PullRequest, SeenLoop, Snapshot } from './types'
+import { buildQuery, parseResponse, type Fetched } from './github'
+import { expandPath, findWatchers, keyOf, parseTracked, type Env, type TrackedPr } from './parse'
+
+type Engine = EngineInterface
+type Loop = { kind: LoopKind; tracked: string }
+
+const PANE = 'loop-prs'
+const TITLE = 'Loop PRs'
+const TICK_MS = 5_000
+const POLL_MS = 30_000
+const EMPTY: Snapshot = { watching: [], reviewing: [], fetchedAt: null, error: null }
+
+const SECTIONS: { kind: LoopKind; title: string }[] = [
+  { kind: 'watching', title: 'Watching' },
+  { kind: 'reviewing', title: 'Reviewing' },
+]
+
+const seen = atom({ plugin: 'projector', key: 'seenLoops' } as const, [])
+const snapshot = atom({ plugin: 'projector', key: 'loopSnapshot' } as const, EMPTY)
+const now = atom({ plugin: 'projector', key: 'loopNow' } as const, 0)
+
+// The session keeps its state across a reload or an update of the plugin,
+// so a value an earlier version wrote can have another shape.
+const isKind = (kind: unknown): kind is LoopKind => SECTIONS.some(section => section.kind === kind)
+const current = (value: Snapshot): Snapshot =>
+  Array.isArray(value.watching) && Array.isArray(value.reviewing) ? value : EMPTY
+
+let envLoad: Promise<Env> | undefined
+let inFlight: Promise<void> | undefined
+let isQueued = false
+let attemptedAt = 0
+const unreadable = new Set<string>()
+
+/** The few variables a tracked path is written with, read once per load. */
+function envOf($: Engine): Promise<Env> {
+  envLoad ??= (async () => {
+    const values: Record<string, string | undefined> = {
+      HOME: await $.env.get('HOME'),
+      TMPDIR: await $.env.get('TMPDIR'),
+      XDG_CONFIG_HOME: await $.env.get('XDG_CONFIG_HOME'),
+      XDG_DATA_HOME: await $.env.get('XDG_DATA_HOME'),
+      XDG_STATE_HOME: await $.env.get('XDG_STATE_HOME'),
+    }
+    return (name: string) => (values[name] === '' ? undefined : values[name])
+  })()
+  return envLoad
+}
+
+async function canonical($: Engine, path: string): Promise<string | undefined> {
+  try {
+    const stat = await $.fs.stat(path, { resolve: true })
+    return stat.realPath ?? path
+  } catch {
+    return undefined
+  }
+}
+
+/** Records a loop, answering whether the session had not seen it before. */
+async function remember($: Engine, loop: SeenLoop): Promise<boolean> {
+  let isNew = false
+  await update($, seen, list => {
+    isNew = !list.some(one => one.tracked === loop.tracked)
+    return isNew ? [...list, loop] : list
+  })
+  return isNew
+}
+
+/**
+ * Records the tracked file of each watcher a command starts, and opens the
+ * pane when one is new. A loop restarts its watcher with the same command,
+ * as a Monitor does each time it expires, so a known one opens nothing and
+ * a path it cannot read is said once.
+ */
+async function adopt($: Engine, command: string): Promise<void> {
+  if (!command.includes('watch-')) return
+  const env = await envOf($)
+  let isAdded = false
+  for (const watcher of findWatchers(command, env)) {
+    if (watcher.tracked === undefined) {
+      if (!unreadable.has(watcher.written)) {
+        unreadable.add(watcher.written)
+        $.ui.toast(`loop-prs: cannot tell which file ${watcher.written} names; run /loop-prs <tracked file>`)
+      }
+      continue
+    }
+    const tracked = (await canonical($, watcher.tracked)) ?? watcher.tracked
+    isAdded = (await remember($, { kind: watcher.kind, tracked })) || isAdded
+  }
+  if (isAdded) show($)
+}
+
+/** Watchers running anywhere on this machine, found by their arguments. */
+async function runningLoops($: Engine, env: Env): Promise<Loop[]> {
+  let stdout: string
+  try {
+    ;({ stdout } = await $.process.run(['ps', '-A', '-o', 'args='], { timeoutMs: 10_000 }))
+  } catch {
+    return []
+  }
+
+  const loops = new Map<string, Loop>()
+  for (const line of stdout.split('\n')) {
+    if (!line.includes('watch-')) continue
+    for (const watcher of findWatchers(line, env)) {
+      // A process's arguments arrive expanded, and a relative path there is
+      // relative to that process, so only an absolute one names its file.
+      if (watcher.tracked === undefined || !watcher.tracked.startsWith('/')) continue
+      const tracked = await canonical($, watcher.tracked)
+      if (tracked !== undefined && !loops.has(tracked)) {
+        loops.set(tracked, { kind: watcher.kind, tracked })
+      }
+    }
+  }
+  return [...loops.values()]
+}
+
+async function fetchPrs($: Engine, prs: readonly TrackedPr[]): Promise<Fetched> {
+  if (prs.length === 0) return { prs: new Map(), error: null }
+  const query = buildQuery(prs)
+  try {
+    const result = await $.process.run(['gh', 'api', 'graphql', '-f', `query=${query.text}`], {
+      timeoutMs: 30_000,
+    })
+    return parseResponse(query, result)
+  } catch (error) {
+    return { prs: new Map(), error: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+async function load($: Engine): Promise<void> {
+  const env = await envOf($)
+  const own = await read($, seen)
+  const running = await runningLoops($, env)
+
+  // A file named by hand takes its kind from the watcher reading it, if one runs.
+  const loops: Loop[] = [
+    ...own.map(loop => ({
+      tracked: loop.tracked,
+      kind: isKind(loop.kind)
+        ? loop.kind
+        : (running.find(one => one.tracked === loop.tracked)?.kind ?? 'watching'),
+    })),
+    ...running.filter(loop => !own.some(one => one.tracked === loop.tracked)),
+  ]
+
+  // A tracked file that is gone belongs to a loop that ended.
+  const sets = await Promise.all(
+    loops.map(async loop => ({
+      kind: loop.kind,
+      entries: await $.fs.read(loop.tracked).then(parseTracked, () => [] as TrackedPr[]),
+    })),
+  )
+
+  const unique = new Map(sets.flatMap(set => set.entries).map(pr => [keyOf(pr), pr]))
+  const fetched = await fetchPrs($, [...unique.values()])
+
+  // When GitHub cannot be reached, keep drawing what it said last time.
+  const last = current(await read($, snapshot))
+  const previous = new Map([...last.watching, ...last.reviewing].map(pr => [keyOf(pr), pr]))
+  const isFetched = fetched.error === null
+
+  const openIn = (kind: LoopKind): PullRequest[] => {
+    const keys = new Set(sets.filter(set => set.kind === kind).flatMap(set => set.entries.map(keyOf)))
+    return [...keys]
+      .map(key => fetched.prs.get(key) ?? (isFetched ? undefined : previous.get(key)))
+      .filter((pr): pr is PullRequest => pr !== undefined && pr.state === 'OPEN')
+  }
+
+  const time = await $.clock.now()
+  await update($, snapshot, () => ({
+    watching: openIn('watching'),
+    reviewing: openIn('reviewing'),
+    fetchedAt: isFetched ? time : last.fetchedAt,
+    error: fetched.error,
+  }))
+  await update($, now, () => time)
+}
+
+const isOpen = async ($: Engine) => (await $.ui.panes()).some(pane => pane.id === PANE)
+
+/**
+ * Reloads the loops and their pull requests, only while the pane is open
+ * unless forced. A request that arrives mid-load runs once more after it,
+ * so a change it was told about is never missed.
+ */
+function refresh($: Engine, isForced = false): Promise<void> {
+  if (inFlight !== undefined) {
+    isQueued = true
+    return inFlight
+  }
+  inFlight = (async () => {
+    try {
+      if (isForced || (await isOpen($))) {
+        attemptedAt = await $.clock.now()
+        await load($)
+      }
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error)
+      await update($, snapshot, last => ({ ...current(last), error: message })).catch(() => undefined)
+    }
+  })().finally(() => {
+    inFlight = undefined
+    if (isQueued) {
+      isQueued = false
+      void refresh($)
+    }
+  })
+  return inFlight
+}
+
+/** Moves the pane's clock on, and polls GitHub once the last load is old enough. */
+async function tick($: Engine): Promise<void> {
+  if (!(await isOpen($))) return
+  const time = await $.clock.now()
+  await update($, now, () => time)
+  if (time - attemptedAt >= POLL_MS) await refresh($)
+}
+
+/** Opens the pane and loads it, from a timer so no hook waits on GitHub. */
+function show($: Engine): void {
+  $.clock.after(1, () => {
+    $.ui.open({ id: PANE, title: TITLE }).catch(() => undefined)
+    void refresh($, true)
+  })
+}
+
+/** Refreshes soon, from a timer so the hook that noticed a change returns at once. */
+const soon = ($: Engine) => $.clock.after(1, () => void refresh($))
+
+const ago = (seconds: number) =>
+  seconds < 5 ? 'just now' : seconds < 60 ? `${seconds}s ago` : `${Math.floor(seconds / 60)}m ago`
+
+/** Labels a pull request `#12` when the pane shows one repository, else by its repository's name. */
+function labeler(prs: readonly PullRequest[]): (pr: PullRequest) => string {
+  const repos = [...new Set(prs.map(pr => pr.repo))]
+  if (repos.length <= 1) return pr => `#${pr.number}`
+  const names = repos.map(repo => repo.split('/')[1])
+  const isNameEnough = new Set(names).size === names.length
+  return pr => `${isNameEnough ? pr.repo.split('/')[1] : pr.repo}#${pr.number}`
+}
+
+export const register: Register = on => {
+  on('session.start', async ($, e, next) => {
+    await $.command.register({
+      name: 'loop-prs',
+      description: 'Show the open pull requests your watch and review loops track',
+      argumentHint: '[tracked file]',
+    })
+    $.clock.every(TICK_MS, () => void tick($))
+    soon($)
+    return next(e)
+  })
+
+  // These hooks only watch: the catch hands back what the event settled to,
+  // so a failure here never runs a tool twice or refuses anything.
+  on('tool.call', { tool: 'Bash' }, async ($, e, next) => {
+    const ran = await next(e)
+    if (ran.deny === undefined) await adopt($, e.command)
+    return ran
+  }).catch(($, e, next) => next(e))
+
+  on('tool.call', { tool: 'Monitor' }, async ($, e, next) => {
+    const ran = await next(e)
+    if (ran.deny === undefined) await adopt($, e.command ?? '')
+    return ran
+  }).catch(($, e, next) => next(e))
+
+  // A watcher's line reaches the session as a task notification: the moment
+  // a pull request it tracks has changed.
+  on('prompt.submit', ($, e, next) => {
+    if (e.origin.kind === 'task-notification') soon($)
+    return next(e)
+  }).catch(($, e, next) => next(e))
+
+  // A turn may have pushed, replied or resolved threads.
+  on('turn.complete', ($, e, next) => {
+    soon($)
+    return next(e)
+  })
+
+  on('command.run', { command: 'loop-prs' }, async ($, e) => {
+    const written = (e.args ?? '').trim()
+    if (written !== '') {
+      const expanded = expandPath(written, await envOf($))
+      const tracked = expanded === undefined ? undefined : await canonical($, expanded)
+      if (tracked === undefined) return { text: `loop-prs: no tracked file at ${written}.` }
+      await remember($, { tracked })
+    }
+    show($)
+    return { text: 'Opened the Loop PRs pane.' }
+  })
+
+  on('ui.render', { component: 'Pane', requestId: PANE }, async ($, e) => {
+    const { Box, Link, Text } = $.ui.resolve(e)
+    const shown = current(await read($, snapshot))
+    const time = await read($, now)
+    const all = [...shown.watching, ...shown.reviewing]
+    const label = labeler(all)
+    const labelWidth = Math.max(0, ...all.map(pr => label(pr).length))
+
+    const drawPr = (pr: PullRequest) => {
+      const notes: { text: string; color: 'error' | 'warning' | 'success' }[] = []
+      if (pr.isConflicting) notes.push({ text: 'conflict', color: 'error' })
+      if (pr.reviewDecision === 'CHANGES_REQUESTED') notes.push({ text: 'changes requested', color: 'error' })
+      if (pr.openThreads > 0) {
+        notes.push({ text: `${pr.openThreads} open thread${pr.openThreads === 1 ? '' : 's'}`, color: 'warning' })
+      }
+      if (pr.reviewDecision === 'APPROVED') notes.push({ text: 'approved', color: 'success' })
+
+      // Only the title gives way to a narrow pane; the label column is as
+      // wide as the longest label, so every title starts in one column.
+      return (
+        <Box key={keyOf(pr)} flexDirection="column">
+          <Box flexDirection="row" columnGap={1}>
+            <Box flexShrink={0} width={labelWidth}>
+              <Link href={pr.url} label={label(pr)} />
+            </Box>
+            <Box flexShrink={0}>
+              <Text color={pr.isDraft ? 'warning' : 'success'}>{pr.isDraft ? 'draft' : 'ready'}</Text>
+            </Box>
+            <Text wrap="truncate-end">{pr.title}</Text>
+          </Box>
+          {notes.length > 0 && (
+            <Box marginLeft={labelWidth + 1}>
+              <Text>
+                {notes.map((note, index) => (
+                  <Text color={note.color}>
+                    {index > 0 ? ' · ' : ''}
+                    {note.text}
+                  </Text>
+                ))}
+              </Text>
+            </Box>
+          )}
+        </Box>
+      )
+    }
+
+    const sections = SECTIONS.filter(section => shown[section.kind].length > 0)
+
+    return (
+      <Box flexDirection="column">
+        {sections.map(section => (
+          <Box key={section.kind} flexDirection="column" marginBottom={1}>
+            <Text bold>{section.title}</Text>
+            {shown[section.kind].map(drawPr)}
+          </Box>
+        ))}
+        {sections.length === 0 && (
+          <Text dimColor>
+            {shown.fetchedAt === null && shown.error === null
+              ? 'Looking for pull requests…'
+              : 'No open pull requests are being watched or reviewed.'}
+          </Text>
+        )}
+        {shown.error !== null && <Text color="error">GitHub: {shown.error}</Text>}
+        {shown.fetchedAt !== null && (
+          <Text dimColor>updated {ago(Math.max(0, Math.round((time - shown.fetchedAt) / 1000)))}</Text>
+        )}
+      </Box>
+    )
+  })
+}
