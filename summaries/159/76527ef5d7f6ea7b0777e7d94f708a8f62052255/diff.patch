+
+    def test_the_compared_release_is_the_one_upgrade_installs(self) -> None:
+        manifest_url = self.unpatched_manifest_url
+
+        upstream = manifest_url({"url": "https://github.com/ninjudd/projector/archive/v0.tar.gz"})
