diff --git a/tests/__init__.py b/tests/__init__.py
index 8147b83e..17b41f71 100644
--- a/tests/__init__.py
+++ b/tests/__init__.py
@@ -18,6 +18,14 @@
 for name in ("GITHUB_REPOSITORY", "GITHUB_ACTIONS"):
     os.environ.pop(name, None)
 
+# Git runs automatic maintenance in a detached background process after a
+# commit, fetch, or merge, and that process can still be adding and removing
+# files under `objects/` when `scratch.copy_of` copies a fixture, which fails the
+# copy. Command-line configuration outranks every config file, so no test's
+# repository can turn it back on.
+os.environ.update({"GIT_CONFIG_COUNT": "2", "GIT_CONFIG_KEY_0": "maintenance.auto", "GIT_CONFIG_VALUE_0": "false",
+                   "GIT_CONFIG_KEY_1": "gc.auto", "GIT_CONFIG_VALUE_1": "0"})
+
 # Claude Code sets this for every command it runs, and project review names it in
 # the signatures it writes, so a test that expects an effort sets one itself.
 os.environ.pop("CLAUDE_EFFORT", None)
diff --git a/tests/test_scratch.py b/tests/test_scratch.py
new file mode 100644
index 00000000..72c13fd3
--- /dev/null
+++ b/tests/test_scratch.py
@@ -0,0 +1,34 @@
+import subprocess
+import unittest
+
+from tests.scratch import copy_of
+
+
+def one_commit(root):
+    subprocess.run(["git", "init", "-q", str(root)], check=True)
+    subprocess.run(["git", "-C", str(root), "-c", "user.name=Test", "-c", "user.email=test@example.com",
+                    "commit", "-q", "--allow-empty", "-m", "first"], check=True)
+
+
+class GitMaintenanceTests(unittest.TestCase):
+    def config(self, root, key):
+        return subprocess.run(["git", "-C", str(root), "config", "--get", key],
+                              capture_output=True, text=True, check=True).stdout.strip()
+
+    def test_fixture_git_runs_no_background_maintenance(self):
+        # Catches the suite letting Git start detached maintenance after a commit, which
+        # deletes files under objects/ while copy_of copies the template.
+        root, _ = copy_of(one_commit)
+        self.assertEqual(self.config(root, "maintenance.auto"), "false")
+        self.assertEqual(self.config(root, "gc.auto"), "0")
+
+    def test_a_repository_config_cannot_turn_maintenance_back_on(self):
+        # Catches the setting moving to a config file, which a test repository's own
+        # `maintenance.auto = true` would outrank.
+        root, _ = copy_of(one_commit)
+        subprocess.run(["git", "-C", str(root), "config", "maintenance.auto", "true"], check=True)
+        self.assertEqual(self.config(root, "maintenance.auto"), "false")
+
+
+if __name__ == "__main__":
+    unittest.main()
