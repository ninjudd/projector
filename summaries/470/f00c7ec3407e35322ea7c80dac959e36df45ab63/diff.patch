diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index f272d6f9..58c2642c 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -27,6 +27,7 @@ jobs:
       actions: write
       contents: write
       pull-requests: write
+      statuses: write
     steps:
       - uses: actions/checkout@v4
       - name: Open the release pull request
@@ -35,17 +36,41 @@ jobs:
           GH_TOKEN: ${{ github.token }}
         run: |
           set -euo pipefail
+          # The checkout is the ref the run was dispatched from, and the release
+          # branch carries every commit it has. The guard below checks only the
+          # release commit, so a run from another ref would sign off that ref's
+          # unreviewed commits.
+          if [ "$GITHUB_REF" != refs/heads/main ]; then
+            echo "run the release from main, not $GITHUB_REF" >&2
+            exit 1
+          fi
           version=$(python3 .github/scripts/release.py bump "$BUMP")
           branch="release/v$version"
           git config user.name "github-actions[bot]"
           git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
           git switch -c "$branch"
           git commit --quiet -am "Release $version"
+          # The status below says this commit changes only the version.
+          changed=$(git diff --name-only HEAD^ HEAD | LC_ALL=C sort | xargs)
+          expected=$(cd .github/scripts && python3 -B -c 'from release import VERSION_FILES; print(*sorted(VERSION_FILES))')
+          if [ "$changed" != "$expected" ]; then
+            echo "the release commit changes $changed, not only $expected" >&2
+            exit 1
+          fi
           # The branch belongs to this workflow; a rerun after a run that pushed it
           # but could not open the pull request replaces it.
           git push --quiet --force origin "$branch"
+          # main requires the projector/review status, and no review session picks
+          # up a pull request this job's token opened. A commit that only raises the
+          # version needs no review, so the job signs off the commit it wrote. The
+          # status names this commit alone, so a push to the branch makes a head
+          # that waits for a review.
+          gh api -X POST "repos/$GITHUB_REPOSITORY/statuses/$(git rev-parse HEAD)" \
+            -f state=success -f context=projector/review \
+            -f description="Version-only release; needs no review" \
+            -f target_url="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" > /dev/null
           cat > "$RUNNER_TEMP/body.md" <<EOF
-          Raises Projector's version to $version in \`pyproject.toml\` and both plugin manifests. Merging this pull request publishes the release: the Release workflow then tags \`v$version\` on the merge commit, moves the major tag to it, and creates the GitHub release with generated notes.
+          Raises Projector's version to $version in \`pyproject.toml\` and both plugin manifests. Merging this pull request publishes the release: the Release workflow then tags \`v$version\` on the merge commit, moves the major tag to it, and creates the GitHub release with generated notes. The workflow posted the \`projector/review\` status on this commit because it changes only the version; a push to this branch needs a review.
 
