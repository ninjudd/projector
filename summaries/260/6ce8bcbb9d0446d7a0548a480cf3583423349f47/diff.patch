 def css(**padding: int) -> str:
     """A stylesheet of six rows, each 8px unless `padding` names it, as r1=9 does."""
     return "".join(f".r{i} {{ padding: {padding.get(f'r{i}', 8)}px; }}\n" for i in range(6))
