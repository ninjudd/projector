+        code, out, err = self.hold("--drop", self.CHANGE)
+
+        self.assertEqual(0, code, err)
+        self.assertEqual({}, self.held())
+        self.assertEqual([f"deleted hold comment {comment} on {REPO}#1, since no change is left in the hold",
