+# Transports
+
+class Outcome(NamedTuple):
+    """What applying one queued change did: whether it landed, what the store said, whether its lease failed, and
+    the version it left, which is None for a deletion and for a change that did not land."""
+
+    ok: bool
+    said: str
+    stale: bool
+    version: Optional[str]
+
+
+class Transport(Protocol):
+    """Where a location's records live, behind what a job asks of it. Each record is named by its ref, and its
+    version is what a lease expects."""
+
+    def snapshot(self, prefixes: tuple[str, ...]) -> dict[str, str]:
+        """Every record under `prefixes`, by ref, with its version."""
+        ...
+
+    def check(self, ref: str, version: str) -> str:
+        """What `read` takes to read the record at `ref`, raising `Rejected` for one the relay refuses unread."""
+        ...
+
+    def read(self, handle: str) -> bytes:
+        """The bytes of a record that `check` admitted, raising `Rejected` when they cannot be read."""
+        ...
+
+    def apply(self, items: list[dict]) -> tuple[dict[str, Outcome], str]:
+        """Apply each queued item under its lease, and answer each one's outcome by ref, with why the ones that
+        did not land failed."""
+        ...
+
+
+class GitTransport:
+    """Records as refs in a Git repository, each a commit holding one `sealed.json`, reached from a checkout or a
+    bare clone at `cwd` whose Git commands take `options`. A version is a commit."""
+
+    def __init__(self, cwd: Path, options: tuple[str, ...] = ()) -> None:
+        self.cwd = cwd
+        self.options = options
+
+    def snapshot(self, prefixes: tuple[str, ...]) -> dict[str, str]:
+        done = git(self.cwd, "fetch", "--prune", "--quiet", "--no-write-fetch-head", REMOTE,
+                   *[f"+{prefix}*:{tracking(prefix)}*" for prefix in prefixes], options=self.options)
+        if done.returncode != 0:
+            raise RelayError(f"git fetch failed: {last_line(done)}")
+        listed = checked(self.cwd, "for-each-ref", "--format=%(objectname) %(refname)",
+                         *[tracking(prefix) for prefix in prefixes], options=self.options)
+        fetched = {}
+        for line in listed.splitlines():
+            sha, name = line.split(" ", 1)
+            fetched[name.replace(f"refs/projector/remotes/{REMOTE}/", "refs/projector/", 1)] = sha
+        return fetched
+
+    def check(self, ref: str, version: str) -> str:
+        """The blob of a commit whose tree is exactly one `sealed.json` of at most 32 KiB."""
+        done = git(self.cwd, "ls-tree", "-l", version, options=self.options)
+        lines = text(done.stdout).splitlines()
+        found = TREE.fullmatch(lines[0]) if done.returncode == 0 and len(lines) == 1 else None
+        if found is None:
+            raise Rejected("tree-shape")
+        if int(found[2]) > MAX_SEALED:
+            raise Rejected("too-large")
+        return found[1]
+
+    def read(self, handle: str) -> bytes:
+        done = git(self.cwd, "cat-file", "blob", handle, options=self.options)
+        if done.returncode != 0:
+            raise Rejected("unreadable")
+        return done.stdout
+
+    def apply(self, items: list[dict]) -> tuple[dict[str, Outcome], str]:
+        """Write each record as a commit, push every change in one `git push`, and move each landed ref's tracking
+        ref to what the push left on origin."""
+        commits: dict[str, str] = {}
+        results: dict[str, tuple[bool, str]] = {}
+        try:
+            for item in items:
+                if item["sealed"] is not None:
+                    commits[item["ref"]] = write_commit(self.cwd, item["sealed"], self.options)
+            # An item you sent to a peer is published again with no lease: only your machines write it, and the
+            # peer may have deleted it since this machine last pushed it.
+            forced = {item["ref"] for item in items
+                      if item["sealed"] is not None and (item.get("meta") or {}).get("force")}
+            leases = [f"--force-with-lease={item['ref']}:{item['old']}" for item in items
+                      if item["old"] and item["ref"] not in forced]
+            specs = [f"{'+' if item['ref'] in forced else ''}{commits[item['ref']]}:{item['ref']}"
+                     if item["sealed"] is not None else f":{item['ref']}" for item in items]
+            done = git(self.cwd, "push", "--porcelain", *leases, REMOTE, *specs, timeout=PUSH_TIMEOUT,
+                       options=self.options)
+            results = push_results(text(done.stdout))
+            failed = f"git push failed: {last_line(done)}"
+        except RelayError as error:
+            failed = str(error)
+        outcomes = {}
+        for item in items:
+            ok, said = results.get(item["ref"], (False, failed))
+            outcomes[item["ref"]] = Outcome(ok, said, not ok and any(word in said for word in STALE),
+                                            commits.get(item["ref"]) if ok else None)
+        lines = "".join(f"update {tracking(ref)} {outcome.version}\n" if outcome.version
+                        else f"delete {tracking(ref)}\n" for ref, outcome in outcomes.items() if outcome.ok)
+        if lines:
+            git(self.cwd, "update-ref", "--stdin", input=lines.encode(), options=self.options)
+        return outcomes, failed
+
+
