+          fi
+          state=$(status "$sha")
+          if [ "$state" = success ]; then
+            echo "kept $name on #$PR, because a review signed off its head ${sha:0:7}"
+            exit 0
+          fi
+          gh pr edit "$PR" --repo "$REPO" --remove-label "$name"
+          sha=$(gh api "repos/$REPO/pulls/$PR" --jq '.head.sha')
+          state=$(status "$sha")
+          if [ "$state" = success ]; then
+            gh pr edit "$PR" --repo "$REPO" --add-label "$name"
+            echo "gave $name back to #$PR, because a review signed off its head ${sha:0:7} while the step removed it"
