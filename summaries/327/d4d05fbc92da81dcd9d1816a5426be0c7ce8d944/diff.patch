+  // A notice's actions name a notice.
+  await ui.press({ key: 'item:2' })
+  expect(await actionLinesOf(ui)).toEqual([
+    'discuss:2 d discuss notice',
+    'dismiss:2 x dismiss notice',
+    'snooze:2 s snooze notice',
