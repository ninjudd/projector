+                mock.patch.dict(os.environ, {"CLAUDE_CODE_SESSION_ID": claude}), \
+                mock.patch("time.time", return_value=self.now), mock.patch.object(sys, "stdin", io.StringIO(stdin)):
+            code = cli.main(["watch", *args])
