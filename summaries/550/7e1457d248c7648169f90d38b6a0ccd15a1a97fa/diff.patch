+def drop_user_only(loaded: dict[str, Any]) -> list[str]:
+    """Remove each `USER_ONLY` key, and everything under it, from a walked file's values, and answer the dotted
+    keys removed. The subtree is found by walking the parsed tables, never by splitting a flattened key, since a
+    quoted key such as `"alice.work"` holds a dot of its own."""
+
+    removed: list[str] = []
+    for name in sorted(USER_ONLY):
+        *tables, last = name.split(".")
+        chain = [loaded]
+        for part in tables:
+            child = chain[-1].get(part)
+            if not isinstance(child, dict):
+                break
+            chain.append(child)
+        else:
+            if last not in chain[-1]:
+                continue
+            value = chain[-1].pop(last)
+            removed += sorted(_flatten(value, f"{name}.")) if isinstance(value, dict) and value else [name]
