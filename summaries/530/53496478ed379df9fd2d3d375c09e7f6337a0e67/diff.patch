+class FakeCurses:
+    """The parts of `curses` that `console.Screen` draws with, for a terminal with no colors."""
+
+    A_DIM, A_BOLD, A_REVERSE = 1, 2, 4
+    KEY_NPAGE, KEY_PPAGE, KEY_HOME, KEY_END = 338, 339, 262, 360
+
+    class error(Exception):
+        pass
