+class Keys(ConsoleCase):
+    def test_left_returns_home_closing_the_drawer_but_moves_the_cursor_in_a_text_field(self) -> None:
+        self.claude("s1")
+        self.ask("s1")
+        self.open_entry("s1", "item:1")
+
+        self.press("7")
+        self.type("ac")
+        self.press("left")
+        self.type("b")
