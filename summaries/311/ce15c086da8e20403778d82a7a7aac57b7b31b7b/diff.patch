+        data["groups"][2]["files"] = []
+        (self.tmp / "pr.diff").write_text(MOVED_DIFF)
+
+        code, _, err = self.refresh(data, "--diff", str(self.tmp / "pr.diff"))
+
+        self.assertEqual(0, code, err)
+        self.assertEqual([], self.compared, "--diff fetches no diff")
