+                    self.assertEqual(2, stop.exception.code)
+            self.assertEqual("make", cli.parser().parse_args([*command, "--prepare=make"]).prepare)
+            self.assertEqual("make", cli.parser().parse_args([*command, "--prepare", "make"]).prepare)
+            self.assertTrue(cli.parser().parse_args([*command, "--allow-prepare"]).allow_prepare)
