+                printed = phrase.format(base="trunk")
+                lead = review.incremental_lead(result, "trunk")
+
+                self.assertIn(f"kind: {printed}", review.interdiff_lines(result, "trunk"))
+                if kind == "push":
+                    self.assertNotIn("across", lead)
+                else:
