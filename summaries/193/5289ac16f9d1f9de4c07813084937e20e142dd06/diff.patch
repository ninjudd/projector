+        self.assertEqual(theirs[0], run(self.remote, "git", "log", "--format=%P", "-1", mine),
+                         "the retry builds on the other publisher's commit")
+        self.assertEqual(first, run(self.remote, "git", "log", "--format=%P", "-1", theirs[0]))
+        files = self.ref_files()
