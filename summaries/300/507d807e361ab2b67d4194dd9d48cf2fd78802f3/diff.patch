+    elif [[ $line =~ $ENTRY_RE ]]; then
+      entries="$entries$line
+"
     else
       echo "$TRACKED:$lineno is not owner/repo#number: $line" >&2
       rc=2
     fi
   done < "$TRACKED"
+  while IFS= read -r line; do
+    [ -n "$line" ] || continue
+    case "$excluded" in *" $(lower "$line") "*) continue ;; esac
+    printf '%s %s\n' "${line%#*}" "${line##*#}"
+  done <<EOF
+$entries
+EOF
   return $rc
 }
 
