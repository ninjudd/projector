diff --git a/services/push/src/limit.ts b/services/push/src/limit.ts
new file mode 100644
index 00000000..c3f1d7d7
--- /dev/null
+++ b/services/push/src/limit.ts
@@ -0,0 +1,39 @@
+/**
+ * Caps how many notifications one device gets in a sliding window. It counts
+ * in this process's memory, so each function instance keeps its own count and
+ * the cap is best-effort, not shared.
+ */
+export class RateLimit {
+  private readonly sent = new Map<string, number[]>();
+  private sweptAt: number;
+
+  constructor(
+    private readonly limit: number,
+    private readonly windowMs: number,
+    private readonly now: () => number = Date.now,
+  ) {
+    this.sweptAt = now();
+  }
+
+  /** Counts one notification for `key`, or returns how many milliseconds remain until `key` may send again. */
+  take(key: string): number {
+    const now = this.now();
+    const since = now - this.windowMs;
+    if (now - this.sweptAt >= this.windowMs) this.sweep(since, now);
+    const times = (this.sent.get(key) ?? []).filter((time) => time > since);
+    this.sent.set(key, times);
+    const [oldest] = times;
+    if (oldest !== undefined && times.length >= this.limit) return oldest + this.windowMs - now;
+    times.push(now);
+    return 0;
+  }
+
+  // Forgets the devices that sent nothing in the window, so memory stays
+  // proportional to the devices that sent recently.
+  private sweep(since: number, now: number): void {
+    for (const [key, times] of this.sent) {
+      if ((times.at(-1) ?? -Infinity) <= since) this.sent.delete(key);
+    }
+    this.sweptAt = now;
+  }
+}
diff --git a/services/push/src/push-id.ts b/services/push/src/push-id.ts
new file mode 100644
index 00000000..9d9a57a7
--- /dev/null
+++ b/services/push/src/push-id.ts
@@ -0,0 +1,72 @@
+import { createCipheriv, createDecipheriv, createSecretKey, randomBytes, type KeyObject } from "node:crypto";
+
+// A push ID is Apple's device token sealed with AES-256-GCM under the
+// service's secret key, so the service can read it back and no one else can
+// read or forge one, and the service stores nothing. GCM is node:crypto's
+// AEAD on every platform Node runs on, and AES is hardware-accelerated almost
+// everywhere. Its nonce is random, because a service with no storage cannot
+// keep a counter: a random 96-bit nonce stays within NIST SP 800-38D's bound
+// for 2^32 seals under one key, and the service seals once per registration.
+//
+// The bytes are: one version byte, the 12-byte nonce, the encrypted token,
+// and the 16-byte tag, in unpadded base64url. The version byte is also the
+// additional authenticated data, so a later format can change everything
+// after it and an ID can never be read as the wrong version.
+const VERSION = 1;
+const NONCE_BYTES = 12;
+const TAG_BYTES = 16;
+const KEY_BYTES = 32;
+// Apple documents device tokens as variable length, so this accepts any
+// length a token plausibly has rather than the 32 bytes tokens have today.
+const MIN_TOKEN_BYTES = 8;
+const MAX_TOKEN_BYTES = 100;
+const DEVICE_TOKEN = /^(?:[0-9a-fA-F]{2})+$/;
+const BASE64URL = /^[A-Za-z0-9_-]+$/;
+const MAX_PUSH_ID_LENGTH = Math.ceil(((1 + NONCE_BYTES + MAX_TOKEN_BYTES + TAG_BYTES) * 4) / 3);
+
+/** Parses Apple's device token from the hex the app sends, or returns null. */
+export function deviceToken(hex: string): Buffer | null {
+  if (!DEVICE_TOKEN.test(hex)) return null;
+  const token = Buffer.from(hex, "hex");
+  return token.length >= MIN_TOKEN_BYTES && token.length <= MAX_TOKEN_BYTES ? token : null;
+}
+
+/** Makes the service's secret key from its base64 encoding, which must hold exactly 32 bytes. */
+export function pushIdKey(base64: string): KeyObject {
+  const bytes = Buffer.from(base64, "base64");
+  if (bytes.length !== KEY_BYTES) {
+    throw new RangeError(`the push ID key must be ${KEY_BYTES} bytes in base64`);
+  }
+  return createSecretKey(bytes);
+}
+
+/** Seals a device token into a push ID that only `key` opens. */
+export function sealPushId(token: Buffer, key: KeyObject): string {
+  const header = Buffer.of(VERSION);
+  const nonce = randomBytes(NONCE_BYTES);
+  const cipher = createCipheriv("aes-256-gcm", key, nonce, { authTagLength: TAG_BYTES });
+  cipher.setAAD(header);
+  const sealed = Buffer.concat([cipher.update(token), cipher.final()]);
+  return Buffer.concat([header, nonce, sealed, cipher.getAuthTag()]).toString("base64url");
+}
+
+/** Opens a push ID to its device token, or returns null for any ID that `key` did not seal. */
+export function openPushId(pushId: string, key: KeyObject): Buffer | null {
+  if (pushId.length > MAX_PUSH_ID_LENGTH || !BASE64URL.test(pushId)) return null;
+  const bytes = Buffer.from(pushId, "base64url");
+  // Base64url decoding ignores stray trailing bits, so an ID that does not
+  // re-encode to itself is a second spelling of another ID, not this one.
+  if (bytes.toString("base64url") !== pushId) return null;
+  const tokenBytes = bytes.length - 1 - NONCE_BYTES - TAG_BYTES;
+  if (bytes[0] !== VERSION || tokenBytes < MIN_TOKEN_BYTES || tokenBytes > MAX_TOKEN_BYTES) return null;
+  const nonce = bytes.subarray(1, 1 + NONCE_BYTES);
+  const sealed = bytes.subarray(1 + NONCE_BYTES, bytes.length - TAG_BYTES);
+  const decipher = createDecipheriv("aes-256-gcm", key, nonce, { authTagLength: TAG_BYTES });
+  decipher.setAAD(bytes.subarray(0, 1));
+  decipher.setAuthTag(bytes.subarray(bytes.length - TAG_BYTES));
+  try {
+    return Buffer.concat([decipher.update(sealed), decipher.final()]);
+  } catch {
+    return null;
+  }
+}
diff --git a/services/push/test/apns.ts b/services/push/test/apns.ts
new file mode 100644
index 00000000..f14ac0c8
--- /dev/null
+++ b/services/push/test/apns.ts
@@ -0,0 +1,197 @@
+import assert from "node:assert/strict";
+import { generateKeyPairSync, verify } from "node:crypto";
+import { connect, type ClientHttp2Session } from "node:http2";
+import { test } from "node:test";
+import { APNS_ORIGINS, apnsConfigFromEnv, ConfigError, createForwarder, providerToken, type ApnsConfig } from "../src/lib.js";
+import { appleKey, config, fakeApns, token, type Answer } from "./support/fakes.js";
+
+async function withApns(answer: (index: number) => Answer, run: (forwarder: ReturnType<typeof createForwarder>, apns: Awaited<ReturnType<typeof fakeApns>>) => Promise<void>, settings: ApnsConfig = config()) {
+  const apns = await fakeApns((_, index) => answer(index));
+  const forwarder = createForwarder(settings, { connect: () => connect(apns.url), timeoutMs: 200 });
+  try {
+    await run(forwarder, apns);
+  } finally {
+    forwarder.close();
+    await apns.close();
+  }
+}
+
+function decode(part: string | undefined): Record<string, unknown> {
+  return JSON.parse(Buffer.from(part ?? "", "base64url").toString("utf8")) as Record<string, unknown>;
+}
+
+test("a notification reaches the device's path with the bundle ID as topic and the sealed text unchanged", async () => {
+  const settings = config();
+  await withApns(() => ({ status: 200 }), async (forwarder, apns) => {
+    const device = token();
+    const notification = "c2VhbGVk+/=\"\\é";
+    assert.deepEqual(await forwarder.send(device, notification), { status: "sent" });
+    const [received] = apns.received;
+    assert.ok(received);
+    assert.equal(received.headers[":method"], "POST");
+    assert.equal(received.headers[":path"], `/3/device/${device.toString("hex")}`);
+    assert.equal(received.headers["apns-topic"], settings.bundleId);
+    assert.equal(received.headers["apns-push-type"], "alert");
+    const payload = JSON.parse(received.body) as { aps: Record<string, unknown>; sealed: string };
+    assert.equal(payload.sealed, notification);
+    assert.equal(payload.aps["mutable-content"], 1);
+  }, settings);
+});
+
+test("the provider token is an ES256 JWT that Apple's push key verifies, with the key ID and team ID", async () => {
+  const { privateKey, publicKey } = appleKey();
+  const settings = config({ key: privateKey });
+  await withApns(() => ({ status: 200 }), async (forwarder, apns) => {
+    const before = Math.floor(Date.now() / 1000);
+    await forwarder.send(token(), "sealed");
+    const authorization = String(apns.received[0]?.headers.authorization);
+    assert.match(authorization, /^bearer [\w-]+\.[\w-]+\.[\w-]+$/);
+    const [header, claims, signature] = authorization.slice("bearer ".length).split(".");
+    assert.deepEqual(decode(header), { alg: "ES256", kid: settings.keyId });
+    const { iss, iat } = decode(claims);
+    assert.equal(iss, settings.teamId);
+    assert.ok(typeof iat === "number" && iat >= before && iat <= Date.now() / 1000);
+    const signed = Buffer.from(`${header}.${claims}`);
+    const raw = Buffer.from(signature ?? "", "base64url");
+    assert.equal(raw.length, 64, "a JWT signature is raw r and s, not DER");
+    assert.ok(verify("sha256", signed, { key: publicKey, dsaEncoding: "ieee-p1363" }, raw));
+  }, settings);
+});
+
+test("one provider token serves 50 minutes, so a token made per request or kept past an hour is caught", () => {
+  let now = 1_700_000_000_000;
+  const tokens = providerToken(config(), () => now);
+  const first = tokens.get();
+  now += 49 * 60 * 1000;
+  assert.equal(tokens.get(), first);
+  now += 60 * 1000;
+  const second = tokens.get();
+  assert.notEqual(second, first);
+  assert.equal(decode(second.split(".")[1]).iat, Math.floor(now / 1000));
+});
+
+test("one forwarder reuses its provider token across notifications", async () => {
+  await withApns(() => ({ status: 200 }), async (forwarder, apns) => {
+    await forwarder.send(token(), "one");
+    await forwarder.send(token(), "two");
+    const [first, second] = apns.received.map((received) => received.headers.authorization);
+    assert.ok(first);
+    assert.equal(second, first);
+  });
+});
+
+test("Apple's ExpiredProviderToken answer makes the next notification carry a new token", async () => {
+  await withApns((index) => (index === 0 ? { status: 403, reason: "ExpiredProviderToken" } : { status: 200 }), async (forwarder, apns) => {
+    assert.deepEqual(await forwarder.send(token(), "one"), { status: "failed", reason: "403 ExpiredProviderToken" });
+    assert.deepEqual(await forwarder.send(token(), "two"), { status: "sent" });
+    const [first, second] = apns.received.map((received) => received.headers.authorization);
+    assert.notEqual(second, first);
+  });
+});
+
+test("Apple's 410 and BadDeviceToken answers report the device unregistered", async () => {
+  const answers: Answer[] = [{ status: 410, reason: "Unregistered" }, { status: 400, reason: "BadDeviceToken" }];
+  await withApns((index) => answers[index] ?? { status: 200 }, async (forwarder) => {
+    assert.deepEqual(await forwarder.send(token(), "one"), { status: "unregistered" });
+    assert.deepEqual(await forwarder.send(token(), "two"), { status: "unregistered" });
+  });
+});
+
+test("any other answer reports failure with Apple's reason, and only a one-word reason", async () => {
+  const answers: Answer[] = [
+    { status: 500, reason: "InternalServerError" },
+    { status: 400, reason: "BadTopic" },
+    { status: 500, reason: "the device token is abcdef" },
+  ];
+  await withApns((index) => answers[index] ?? { status: 200 }, async (forwarder) => {
+    assert.deepEqual(await forwarder.send(token(), "one"), { status: "failed", reason: "500 InternalServerError" });
+    assert.deepEqual(await forwarder.send(token(), "two"), { status: "failed", reason: "400 BadTopic" });
+    assert.deepEqual(await forwarder.send(token(), "three"), { status: "failed", reason: "500" });
+  });
+});
+
+test("a notification Apple never answers fails after the timeout instead of hanging the call", async () => {
+  await withApns(() => "hang", async (forwarder) => {
+    assert.deepEqual(await forwarder.send(token(), "sealed"), { status: "failed", reason: "timeout" });
+  });
+});
+
+test("a request that fails on a reused connection before Apple answers gets one fresh connection", async () => {
+  const apns = await fakeApns((_, index) => (index === 1 ? "reset" : { status: 200 }));
+  const sessions: ClientHttp2Session[] = [];
+  const forwarder = createForwarder(config(), {
+    connect: () => {
+      const session = connect(apns.url);
+      sessions.push(session);
+      return session;
+    },
+  });
+  try {
+    assert.deepEqual(await forwarder.send(token(), "one"), { status: "sent" });
+    assert.deepEqual(await forwarder.send(token(), "two"), { status: "sent" });
+    assert.equal(sessions.length, 2);
+    assert.deepEqual(apns.received.map((received) => JSON.parse(received.body).sealed), ["one", "two", "two"]);
+  } finally {
+    forwarder.close();
+    await apns.close();
+  }
+});
+
+test("a request that fails on a fresh connection is not retried, so a dead host costs one attempt", async () => {
+  await withApns(() => "reset", async (forwarder, apns) => {
+    assert.deepEqual(await forwarder.send(token(), "sealed"), { status: "failed", reason: "connection" });
+    assert.equal(apns.received.length, 1);
+  });
+});
+
+test("a connection that refuses new requests reports failure, so send never rejects", async () => {
+  const apns = await fakeApns();
+  const forwarder = createForwarder(config(), {
+    connect: () => {
+      const session = connect(apns.url);
+      session.close();
+      return session;
+    },
+  });
+  try {
+    assert.deepEqual(await forwarder.send(token(), "sealed"), { status: "failed", reason: "connection" });
+  } finally {
+    forwarder.close();
+    await apns.close();
+  }
+});
+
+test("APNS_ENVIRONMENT picks Apple's sandbox or production host, and nothing else", async () => {
+  const apns = await fakeApns();
+  try {
+    const pem = appleKey().privateKey.export({ type: "pkcs8", format: "pem" }).toString();
+    const env = { APNS_KEY: pem, APNS_KEY_ID: "KEY1234567", APNS_TEAM_ID: "TEAM123456", APNS_BUNDLE_ID: "bot.projector.example" };
+    for (const [environment, host] of [["sandbox", "https://api.sandbox.push.apple.com"], ["production", "https://api.push.apple.com"]] as const) {
+      const origins: string[] = [];
+      const forwarder = createForwarder(apnsConfigFromEnv({ ...env, APNS_ENVIRONMENT: environment }), {
+        connect: (origin) => {
+          origins.push(origin);
+          return connect(apns.url);
+        },
+      });
+      await forwarder.send(token(), "sealed");
+      forwarder.close();
+      assert.deepEqual(origins, [host]);
+      assert.equal(APNS_ORIGINS[environment], host);
+    }
+    for (const environment of ["development", "Production", ""]) {
+      assert.throws(() => apnsConfigFromEnv({ ...env, APNS_ENVIRONMENT: environment }), ConfigError);
+    }
+  } finally {
+    await apns.close();
+  }
+});
+
+test("a push key that is not P-256 is refused when the service starts, not at Apple", () => {
+  const env = { APNS_KEY_ID: "KEY1234567", APNS_TEAM_ID: "TEAM123456", APNS_BUNDLE_ID: "bot.projector.example", APNS_ENVIRONMENT: "sandbox" };
+  for (const pair of [generateKeyPairSync("ec", { namedCurve: "P-384" }), generateKeyPairSync("ed25519")]) {
+    const pem = pair.privateKey.export({ type: "pkcs8", format: "pem" }).toString();
+    assert.throws(() => apnsConfigFromEnv({ ...env, APNS_KEY: pem }), /APNS_KEY must be a P-256 key/);
+  }
+  assert.throws(() => apnsConfigFromEnv({ ...env, APNS_KEY: "not a key" }), /APNS_KEY must hold/);
+});
diff --git a/services/push/test/handlers.ts b/services/push/test/handlers.ts
new file mode 100644
index 00000000..3c1983b3
--- /dev/null
+++ b/services/push/test/handlers.ts
@@ -0,0 +1,178 @@
+import assert from "node:assert/strict";
+import { randomBytes } from "node:crypto";
+import { test } from "node:test";
+import { HOURLY_LIMIT, MAX_NOTIFICATION_BYTES, push, pushFromEnv, register, registerFromEnv, type PushDeps } from "../src/handlers.js";
+import { RateLimit } from "../src/limit.js";
+import { openPushId, pushIdKey, sealPushId, type Outcome } from "../src/lib.js";
+import { appleKey, fakeForwarder, token } from "./support/fakes.js";
+
+const HOUR = 60 * 60 * 1000;
+const key = pushIdKey(randomBytes(32).toString("base64"));
+
+function post(body: unknown): Request {
+  return new Request("https://push.example/v1/push", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: typeof body === "string" ? body : JSON.stringify(body),
+  });
+}
+
+function deps(outcome?: Outcome, now: () => number = Date.now) {
+  const { forwarder, sent } = fakeForwarder(outcome);
+  const logs: string[] = [];
+  const pushDeps: PushDeps = { key, forwarder, limit: new RateLimit(HOURLY_LIMIT, HOUR, now), log: (line) => logs.push(line) };
+  return { deps: pushDeps, sent, logs };
+}
+
+test("register answers a push ID that opens to the phone's device token", async () => {
+  const device = token();
+  const response = await register(post({ token: device.toString("hex") }), { key });
+  assert.equal(response.status, 200);
+  const { push_id: pushId } = (await response.json()) as { push_id: string };
+  assert.deepEqual(openPushId(pushId, key), device);
+});
+
+test("register refuses a token that is not hex, so junk never becomes a push ID", async () => {
+  assert.equal((await register(post({ token: "not a token" }), { key })).status, 400);
+  assert.equal((await register(post({}), { key })).status, 400);
+  assert.equal((await register(post("not json"), { key })).status, 400);
+});
+
+test("push forwards the sealed notification unchanged to the push ID's device, and answers 202", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const device = token();
+  const notification = "c2VhbGVk.bm90aWZpY2F0aW9u+/=";
+  const response = await push(post({ push_id: sealPushId(device, key), notification }), pushDeps);
+  assert.equal(response.status, 202);
+  assert.deepEqual(sent, [{ token: device, notification }]);
+});
+
+test("a tampered push ID gets 404 and nothing is forwarded, so a forged ID reaches no device", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const pushId = sealPushId(token(), key);
+  const tampered = (pushId.startsWith("A") ? "B" : "A") + pushId.slice(1);
+  const response = await push(post({ push_id: tampered, notification: "sealed" }), pushDeps);
+  assert.equal(response.status, 404);
+  assert.deepEqual(sent, []);
+});
+
+test("a push ID another instance sealed gets 404 and nothing is forwarded", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const foreign = sealPushId(token(), pushIdKey(randomBytes(32).toString("base64")));
+  const response = await push(post({ push_id: foreign, notification: "sealed" }), pushDeps);
+  assert.equal(response.status, 404);
+  assert.deepEqual(sent, []);
+});
+
+test("push logs neither the notification, the push ID, nor the device token, even when Apple fails", async (t) => {
+  const printed: string[] = [];
+  for (const method of ["log", "info", "warn", "error", "debug"] as const) {
+    t.mock.method(console, method, (...args: unknown[]) => printed.push(args.map(String).join(" ")));
+  }
+  const { deps: pushDeps, logs } = deps({ status: "failed", reason: "500 InternalServerError" });
+  const device = token();
+  const pushId = sealPushId(device, key);
+  const notification = "sealed-notification-text";
+  assert.equal((await push(post({ push_id: pushId, notification }), pushDeps)).status, 502);
+  const lines = [...logs, ...printed];
+  assert.ok(lines.length > 0, "the failure is logged");
+  for (const line of lines) {
+    for (const secret of [notification, pushId, device.toString("hex"), device.toString("base64")]) {
+      assert.ok(!line.includes(secret), `logged ${JSON.stringify(line)}`);
+    }
+  }
+});
+
+test("a notification over 2 KiB gets 413 and is not forwarded, and one of exactly 2 KiB is sent", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const pushId = sealPushId(token(), key);
+  const over = await push(post({ push_id: pushId, notification: "x".repeat(MAX_NOTIFICATION_BYTES + 1) }), pushDeps);
+  assert.equal(over.status, 413);
+  assert.deepEqual(sent, []);
+  const exact = await push(post({ push_id: pushId, notification: "x".repeat(MAX_NOTIFICATION_BYTES) }), pushDeps);
+  assert.equal(exact.status, 202);
+});
+
+test("the 2 KiB limit counts UTF-8 bytes, so a limit that counts characters is caught", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const notification = "é".repeat(MAX_NOTIFICATION_BYTES / 2 + 1);
+  assert.ok(notification.length <= MAX_NOTIFICATION_BYTES);
+  const response = await push(post({ push_id: sealPushId(token(), key), notification }), pushDeps);
+  assert.equal(response.status, 413);
+  assert.deepEqual(sent, []);
+});
+
+test("a body far larger than any push is refused without being parsed", async () => {
+  const { deps: pushDeps, sent } = deps();
+  const response = await push(post("x".repeat(64 * 1024)), pushDeps);
+  assert.equal(response.status, 413);
+  assert.deepEqual(sent, []);
+});
+
+test("a push ID Apple reports as unregistered gets 404, so the daemon can drop it", async () => {
+  const { deps: pushDeps } = deps({ status: "unregistered" });
+  const response = await push(post({ push_id: sealPushId(token(), key), notification: "sealed" }), pushDeps);
+  assert.equal(response.status, 404);
+});
+
+test("the 61st push in an hour for one push ID gets 429, and another push ID still sends", async () => {
+  let now = 1_000_000;
+  const { deps: pushDeps, sent } = deps(undefined, () => now);
+  const pushId = sealPushId(token(), key);
+  for (let index = 0; index < HOURLY_LIMIT; index++) {
+    assert.equal((await push(post({ push_id: pushId, notification: "sealed" }), pushDeps)).status, 202, `push ${index + 1}`);
+    now += 1000;
+  }
+  const limited = await push(post({ push_id: pushId, notification: "sealed" }), pushDeps);
+  assert.equal(limited.status, 429);
+  assert.equal(limited.headers.get("retry-after"), String(HOUR / 1000 - HOURLY_LIMIT));
+  assert.equal(sent.length, HOURLY_LIMIT);
+  const other = await push(post({ push_id: sealPushId(token(), key), notification: "sealed" }), pushDeps);
+  assert.equal(other.status, 202);
+});
+
+test("registering the same phone again gives a new push ID but no more notifications", async () => {
+  const { deps: pushDeps } = deps(undefined, () => 1_000_000);
+  const device = token();
+  for (let index = 0; index < HOURLY_LIMIT; index++) {
+    await push(post({ push_id: sealPushId(device, key), notification: "sealed" }), pushDeps);
+  }
+  const fresh = sealPushId(device, key);
+  assert.equal((await push(post({ push_id: fresh, notification: "sealed" }), pushDeps)).status, 429);
+});
+
+test("the hour slides: a push ID at the limit gets one more push as each old one turns an hour old", async () => {
+  const start = 1_000_000;
+  let now = start;
+  const { deps: pushDeps } = deps(undefined, () => now);
+  const pushId = sealPushId(token(), key);
+  for (let index = 0; index < HOURLY_LIMIT; index++) {
+    await push(post({ push_id: pushId, notification: "sealed" }), pushDeps);
+    now += 1000;
+  }
+  assert.equal((await push(post({ push_id: pushId, notification: "sealed" }), pushDeps)).status, 429);
+  now = start + HOUR;
+  assert.equal((await push(post({ push_id: pushId, notification: "sealed" }), pushDeps)).status, 202);
+  assert.equal((await push(post({ push_id: pushId, notification: "sealed" }), pushDeps)).status, 429);
+});
+
+test("an unconfigured service answers 500 and logs the variable's name, never a value", async () => {
+  const logs: string[] = [];
+  const unregistered = await registerFromEnv({}, (line) => logs.push(line))(post({ token: token().toString("hex") }));
+  assert.equal(unregistered.status, 500);
+  assert.deepEqual(logs, ["push: PUSH_ID_KEY is not set"]);
+
+  const pem = appleKey().privateKey.export({ type: "pkcs8", format: "pem" }).toString();
+  logs.length = 0;
+  const env = {
+    PUSH_ID_KEY: randomBytes(32).toString("base64"),
+    APNS_KEY: pem,
+    APNS_KEY_ID: "KEY1234567",
+    APNS_TEAM_ID: "TEAM123456",
+    APNS_BUNDLE_ID: "bot.projector.example",
+    APNS_ENVIRONMENT: "development",
+  };
+  const pushed = await pushFromEnv(env, (line) => logs.push(line))(post({ push_id: "x", notification: "sealed" }));
+  assert.equal(pushed.status, 500);
+  assert.deepEqual(logs, ["push: APNS_ENVIRONMENT must be production or sandbox"]);
+});
