# The contents of Apple's .p8 push key file, from BEGIN to END.
APNS_KEY=
# The push key's 10-character key ID.
APNS_KEY_ID=
# The Apple developer team ID that owns the push key and the app.
APNS_TEAM_ID=
# The bundle ID of the build this instance wakes.
APNS_BUNDLE_ID=
# production for TestFlight and App Store builds, sandbox for an Xcode-installed build.
APNS_ENVIRONMENT=
# The service's secret key, which seals push IDs: 32 random bytes in base64,
# as `openssl rand -base64 32` prints. Changing it voids every push ID.
PUSH_ID_KEY=
